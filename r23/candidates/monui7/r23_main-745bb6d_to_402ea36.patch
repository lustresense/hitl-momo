+
+export interface TemporalFeatureStep {
+  features: Float32Array;
+  valid: boolean;
+  didReset: boolean;
+  resetReason: string | null;
+  dtMs: number;
+  lossElapsedMs: number;
+  qualityGate: DerivedQualityGate;
