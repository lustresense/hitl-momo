+    const { video } = makeFakeVideo({
+      totalVideoFrames: () => decodedFrames,
+      currentTime: () => clockMs / 1000,
+    });
+
+    let lastCamStep = -1;
+    // 60 polls over 1000 ms (~60 Hz), camera updates every 4th poll (~15 Hz)
+    for (let i = 0; i < 60; i++) {
+      clockMs = i * 16.67;
+      const camStep = Math.floor(i / 4);
+      if (camStep !== lastCamStep) {
+        decodedFrames++;
+        lastCamStep = camStep;
+      }
