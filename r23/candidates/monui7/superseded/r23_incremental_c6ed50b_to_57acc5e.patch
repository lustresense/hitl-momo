index 0000000000000000000000000000000000000000..a81c0687d5ab435e8bbe62caaee5e4e3912d2d3c
--- /dev/null
+++ b/frontend/implementation/src/components/nui-lab/bench/monui7-rescue.ts
@@ -0,0 +1,289 @@
+/**
+ * MoNUI-7 Rescue State Machine (`bench/monui7-rescue.ts`).
+ *
+ * Implements Lampiran A:
+ * - States: NORMAL, SEARCH, RESCUE_TRACK, POSITION_ONLY, LOST
+ * - Constants (prototype parameters):
+ *   RESCUE_ENTER_MISS_MS = 100
+ *   YOLO_INTERVAL_MS = 100 (<= 10 Hz)
+ *   YOLO_MIN_SCORE = 0.35
+ *   CROP_SCALE = 1.6
+ *   POSITION_ONLY_AFTER_MS = 500
+ *   LOST_PROMPT_AFTER_MS = 2000
+ *   RESCUE_TRACK_MAX_FAILS = 3
+ */
+
+export const RESCUE_ENTER_MISS_MS = 100;
+export const YOLO_INTERVAL_MS = 100;
+export const YOLO_MIN_SCORE = 0.35;
+export const CROP_SCALE = 1.6;
+export const POSITION_ONLY_AFTER_MS = 500;
+export const LOST_PROMPT_AFTER_MS = 2000;
+export const RESCUE_TRACK_MAX_FAILS = 3;
+
+export type RescueState = "NORMAL" | "SEARCH" | "RESCUE_TRACK" | "POSITION_ONLY" | "LOST";
+
+export interface RescueInput {
+  t: number;
+  mpHand: boolean;
+  yolo?: { box: [number, number, number, number]; score: number } | null;
+  crop?: Array<{ x: number; y: number; z?: number }> | null;
+}
+
+export type RescueEvent =
+  | "RESCUE_START"
+  | "RESCUE_SUCCESS"
+  | "RESCUE_FAIL"
+  | "POSITION_ONLY_ENTER"
+  | "POSITION_ONLY_EXIT";
+
+export interface RescueStepResult {
+  state: RescueState;
+  shouldRunYolo: boolean;
+  shouldRunCrop: boolean;
+  cropBox: [number, number, number, number] | null;
+  positionOnly: { cx: number; cy: number; score: number } | null;
+  event: RescueEvent | null;
+}
+
+/**
+ * Computes square crop from box [x1, y1, x2, y2], scaled by scale (default 1.6) and clamped to [0, 1].
+ */
+export function computeCropSquareFromBox(
+  box: [number, number, number, number],
+  scale = CROP_SCALE,
+): [number, number, number, number] {
+  const [x1, y1, x2, y2] = box;
+  const cx = (x1 + x2) / 2;
+  const cy = (y1 + y2) / 2;
+  const w = Math.max(0.01, x2 - x1);
+  const h = Math.max(0.01, y2 - y1);
+  const side = Math.max(w, h) * scale;
+
+  const cropX1 = Math.max(0, cx - side / 2);
+  const cropY1 = Math.max(0, cy - side / 2);
+  const cropX2 = Math.min(1, cx + side / 2);
+  const cropY2 = Math.min(1, cy + side / 2);
+
+  return [cropX1, cropY1, cropX2, cropY2];
+}
+
+/**
+ * Computes square crop from 21 landmarks, scaled and clamped to [0, 1].
+ */
+export function computeCropSquareFromLandmarks(
+  landmarks: Array<{ x: number; y: number }>,
+  scale = CROP_SCALE,
+): [number, number, number, number] {
+  if (!landmarks || landmarks.length === 0) return [0, 0, 1, 1];
+  let minX = 1;
+  let minY = 1;
+  let maxX = 0;
+  let maxY = 0;
+  for (const pt of landmarks) {
+    if (pt.x < minX) minX = pt.x;
+    if (pt.x > maxX) maxX = pt.x;
+    if (pt.y < minY) minY = pt.y;
+    if (pt.y > maxY) maxY = pt.y;
+  }
+  return computeCropSquareFromBox([minX, minY, maxX, maxY], scale);
+}
+
+/**
+ * Maps normalized landmarks inside crop [cropX1, cropY1, cropX2, cropY2]
+ * back to full-frame normalized coordinates.
+ */
+export function unmapLandmarksFromCrop<T extends { x: number; y: number; z?: number }>(
+  landmarks: T[],
+  crop: [number, number, number, number],
+): T[] {
+  const [cropX1, cropY1, cropX2, cropY2] = crop;
+  const cropW = cropX2 - cropX1;
+  const cropH = cropY2 - cropY1;
+
+  return landmarks.map((pt) => ({
+    ...pt,
+    x: cropX1 + pt.x * cropW,
+    y: cropY1 + pt.y * cropH,
+    z: pt.z !== undefined ? pt.z * Math.max(cropW, cropH) : 0,
+  })) as T[];
+}
+
+export class RescueFSM {
+  private stateNow: RescueState = "NORMAL";
+  private handMissingSinceMs: number | null = null;
+  private lastYoloTimeMs = -Infinity;
+  private boxPresentSinceMs: number | null = null;
+  private lastBoxSeenMs: number | null = null;
+  private lastAnyActivityMs = 0;
+  private consecutiveCropFails = 0;
+  private lastKnownCropBox: [number, number, number, number] | null = null;
+  private lastPositionOnly: { cx: number; cy: number; score: number } | null = null;
+
+  constructor(initialState: RescueState = "NORMAL") {
+    this.stateNow = initialState;
+  }
+
+  get state(): RescueState {
+    return this.stateNow;
+  }
+
+  reset(nowMs = 0): void {
+    this.stateNow = "NORMAL";
+    this.handMissingSinceMs = null;
+    this.lastYoloTimeMs = -Infinity;
+    this.boxPresentSinceMs = null;
+    this.lastBoxSeenMs = null;
+    this.lastAnyActivityMs = nowMs;
+    this.consecutiveCropFails = 0;
+    this.lastKnownCropBox = null;
+    this.lastPositionOnly = null;
+  }
+
+  update(input: RescueInput): RescueStepResult {
+    const { t, mpHand, yolo, crop } = input;
+    const prevState = this.stateNow;
+    let event: RescueEvent | null = null;
+
+    const hasBox = yolo !== null && yolo !== undefined && yolo.score >= YOLO_MIN_SCORE;
+    const hasPoints = crop !== null && crop !== undefined && crop.length === 21;
+
+    if (hasBox) {
+      this.lastBoxSeenMs = t;
+      if (this.boxPresentSinceMs === null) {
+        this.boxPresentSinceMs = t;
+      }
+      const [bx1, by1, bx2, by2] = yolo.box;
+      this.lastPositionOnly = {
+        cx: (bx1 + bx2) / 2,
+        cy: (by1 + by2) / 2,
+        score: yolo.score,
+      };
+      this.lastKnownCropBox = computeCropSquareFromBox(yolo.box);
+    } else {
+      this.boxPresentSinceMs = null;
+    }
+
+    if (hasPoints) {
+      this.consecutiveCropFails = 0;
+      this.lastKnownCropBox = computeCropSquareFromLandmarks(crop!);
+    } else if (this.stateNow === "RESCUE_TRACK") {
+      this.consecutiveCropFails++;
+    }
+
+    if (mpHand || hasBox || hasPoints) {
+      this.lastAnyActivityMs = t;
+    }
+
+    // State machine evaluation per Lampiran A
+    switch (this.stateNow) {
+      case "NORMAL": {
+        if (!mpHand) {
+          if (this.handMissingSinceMs === null) {
+            this.handMissingSinceMs = t;
+          }
+          if (t - this.handMissingSinceMs >= RESCUE_ENTER_MISS_MS) {
+            this.stateNow = "SEARCH";
+            event = "RESCUE_START";
+          }
+        } else {
+          this.handMissingSinceMs = null;
+        }
+        break;
+      }
+
+      case "SEARCH": {
+        if (mpHand) {
+          this.stateNow = "NORMAL";
+          this.handMissingSinceMs = null;
+        } else if (hasBox && hasPoints) {
+          this.stateNow = "RESCUE_TRACK";
+          event = "RESCUE_SUCCESS";
+        } else if (
+          hasBox &&
+          !hasPoints &&
+          this.boxPresentSinceMs !== null &&
+          t - this.boxPresentSinceMs >= POSITION_ONLY_AFTER_MS
+        ) {
+          this.stateNow = "POSITION_ONLY";
+          event = "POSITION_ONLY_ENTER";
+        } else if (
+          !hasBox &&
+          !hasPoints &&
+          t - this.lastAnyActivityMs >= LOST_PROMPT_AFTER_MS
+        ) {
+          this.stateNow = "LOST";
+          event = "RESCUE_FAIL";
+        }
+        break;
+      }
+
+      case "RESCUE_TRACK": {
+        if (mpHand) {
+          this.stateNow = "NORMAL";
+          this.handMissingSinceMs = null;
+        } else if (this.consecutiveCropFails >= RESCUE_TRACK_MAX_FAILS) {
+          this.stateNow = "SEARCH";
+        }
+        break;
+      }
+
+      case "POSITION_ONLY": {
+        if (mpHand) {
+          this.stateNow = "NORMAL";
+          this.handMissingSinceMs = null;
+          event = "POSITION_ONLY_EXIT";
+        } else if (hasPoints) {
+          this.stateNow = "RESCUE_TRACK";
+          event = "POSITION_ONLY_EXIT";
+        } else if (
+          !hasBox &&
+          this.lastBoxSeenMs !== null &&
+          t - this.lastBoxSeenMs >= LOST_PROMPT_AFTER_MS
+        ) {
+          this.stateNow = "LOST";
+          event = "POSITION_ONLY_EXIT";
+        }
+        break;
+      }
+
+      case "LOST": {
+        if (mpHand) {
+          this.stateNow = "NORMAL";
+          this.handMissingSinceMs = null;
+        } else if (hasBox && hasPoints) {
+          this.stateNow = "RESCUE_TRACK";
+          event = "RESCUE_SUCCESS";
+        } else if (hasBox) {
+          this.stateNow = "SEARCH";
+        }
+        break;
+      }
+    }
+
+    // Determine actions for current state
+    const shouldRunYolo =
+      (this.stateNow === "SEARCH" || this.stateNow === "POSITION_ONLY" || this.stateNow === "LOST") &&
+      t - this.lastYoloTimeMs >= YOLO_INTERVAL_MS;
+
+    if (shouldRunYolo) {
+      this.lastYoloTimeMs = t;
+    }
+
+    const shouldRunCrop =
+      this.stateNow === "RESCUE_TRACK" ||
+      (this.stateNow === "SEARCH" && hasBox) ||
+      (this.stateNow === "POSITION_ONLY" && hasBox);
+
+    const positionOnly = this.stateNow === "POSITION_ONLY" ? this.lastPositionOnly : null;
+
+    return {
+      state: this.stateNow,
+      shouldRunYolo,
+      shouldRunCrop,
+      cropBox: this.lastKnownCropBox,
+      positionOnly,
+      event,
+    };
+  }
+}
diff --git a/frontend/implementation/src/components/nui-lab/bench/monui7-yolo.ts b/frontend/implementation/src/components/nui-lab/bench/monui7-yolo.ts
new file mode 100644
index 0000000000000000000000000000000000000000..980402a0e7439edceb863c2eb439f67d18704ae4
--- /dev/null
+++ b/frontend/implementation/src/components/nui-lab/bench/monui7-yolo.ts
@@ -0,0 +1,259 @@
+/**
+ * MoNUI-7 YOLO Module for Web Worker (`bench/monui7-yolo.ts`).
+ *
+ * Implements T21:
+ * - Letterboxing to 320x320 with padding 114.
+ * - RGB scaling [0, 1] with NCHW layout.
+ * - Parses YOLO outputs (both end-to-end [1, N, 6] and standard [1, 5, N] / [1, N, 5]).
+ * - Maps bounding boxes back to normalized [0, 1] frame coordinates.
+ * - Filters detections with confidence >= 0.35.
+ * - SHA-256 verification on load (fail-closed).
+ */
+
+export const YOLO_INPUT_SIZE = 320;
+export const YOLO_LETTERBOX_PAD = 114;
+export const YOLO_DEFAULT_CONFIDENCE = 0.35;
+
+export interface LetterboxMeta {
+  srcW: number;
+  srcH: number;
+  newW: number;
+  newH: number;
+  padLeft: number;
+  padTop: number;
+  scale: number;
+}
+
+export interface YoloDetection {
+  /** Normalized [x1, y1, x2, y2] in full frame coordinates (0..1). */
+  box: [number, number, number, number];
+  score: number;
+  classId: number;
+  label?: string;
+}
+
+/**
+ * Resizes and letterboxes an RGBA image buffer to 320x320 NCHW Float32Array.
+ * Padding value is 114 / 255.
+ */
+export function letterboxRgbaToNchw(
+  srcRgba: Uint8ClampedArray | Uint8Array,
+  srcW: number,
+  srcH: number,
+  targetSize = YOLO_INPUT_SIZE,
+  padVal = YOLO_LETTERBOX_PAD,
+): { tensor: Float32Array; meta: LetterboxMeta } {
+  const scale = Math.min(targetSize / srcW, targetSize / srcH);
+  const newW = Math.round(srcW * scale);
+  const newH = Math.round(srcH * scale);
+  const padLeft = Math.floor((targetSize - newW) / 2);
+  const padTop = Math.floor((targetSize - newH) / 2);
+
+  const meta: LetterboxMeta = {
+    srcW,
+    srcH,
+    newW,
+    newH,
+    padLeft,
+    padTop,
+    scale,
+  };
+
+  const channelSize = targetSize * targetSize;
+  const tensor = new Float32Array(3 * channelSize);
+  const normPad = padVal / 255;
+
+  // Initialize tensor with padding value
+  tensor.fill(normPad);
+
+  const rOffset = 0;
+  const gOffset = channelSize;
+  const bOffset = channelSize * 2;
+
+  // Nearest-neighbor / bilinear sampling into the centered ROI
+  for (let dy = 0; dy < newH; dy++) {
+    const sy = Math.min(srcH - 1, Math.floor(dy / scale));
+    const targetY = padTop + dy;
+    const targetRowOffset = targetY * targetSize;
+
+    for (let dx = 0; dx < newW; dx++) {
+      const sx = Math.min(srcW - 1, Math.floor(dx / scale));
+      const targetX = padLeft + dx;
+      const targetIdx = targetRowOffset + targetX;
+
+      const srcIdx = (sy * srcW + sx) * 4;
+      const r = srcRgba[srcIdx] ?? 0;
+      const g = srcRgba[srcIdx + 1] ?? 0;
+      const b = srcRgba[srcIdx + 2] ?? 0;
+      tensor[rOffset + targetIdx] = r / 255;
+      tensor[gOffset + targetIdx] = g / 255;
+      tensor[bOffset + targetIdx] = b / 255;
+    }
+  }
+
+  return { tensor, meta };
+}
+
+/**
+ * Unletterboxes a box in 320x320 letterbox coordinates [bx1, by1, bx2, by2]
+ * back to normalized frame coordinates [x1, y1, x2, y2] in [0, 1].
+ */
+export function unletterboxBox(
+  box320: [number, number, number, number],
+  meta: LetterboxMeta,
+): [number, number, number, number] {
+  const [bx1, by1, bx2, by2] = box320;
+  const x1 = Math.max(0, Math.min(1, (bx1 - meta.padLeft) / meta.newW));
+  const y1 = Math.max(0, Math.min(1, (by1 - meta.padTop) / meta.newH));
+  const x2 = Math.max(0, Math.min(1, (bx2 - meta.padLeft) / meta.newW));
+  const y2 = Math.max(0, Math.min(1, (by2 - meta.padTop) / meta.newH));
+  return [x1, y1, x2, y2];
+}
+
+/**
+ * Parses ONNX output tensor into detections, supporting:
+ * - End-to-end NMS output: shape [1, N, 6] (x1, y1, x2, y2, score, classId)
+ * - Raw YOLO head output: shape [1, 4 + C, N] or [1, N, 4 + C] (cx, cy, w, h, class_scores...)
+ */
+export function parseYoloOutput(
+  data: Float32Array | number[],
+  dims: readonly number[],
+  meta: LetterboxMeta,
+  minScore = YOLO_DEFAULT_CONFIDENCE,
+): YoloDetection[] {
+  const detections: YoloDetection[] = [];
+  const getVal = (idx: number): number => data[idx] ?? 0;
+
+  // Flattened length check
+  if (!dims || dims.length < 2) return detections;
+
+  const dim0 = dims[0] ?? 0;
+  const dim1 = dims[1] ?? 0;
+  const dim2 = dims[2] ?? 0;
+
+  // Case 1: [1, N, 6] or [N, 6] - End-to-end YOLO26 format
+  if ((dims.length === 3 && dim2 === 6) || (dims.length === 2 && dim1 === 6)) {
+    const numDets = dims.length === 3 ? dim1 : dim0;
+    for (let i = 0; i < numDets; i++) {
+      const offset = i * 6;
+      const score = getVal(offset + 4);
+      if (score >= minScore) {
+        const bx1 = getVal(offset);
+        const by1 = getVal(offset + 1);
+        const bx2 = getVal(offset + 2);
+        const by2 = getVal(offset + 3);
+        const classId = Math.round(getVal(offset + 5));
+        const frameBox = unletterboxBox([bx1, by1, bx2, by2], meta);
+        detections.push({ box: frameBox, score, classId });
+      }
+    }
+    detections.sort((a, b) => b.score - a.score);
+    return detections;
+  }
+
+  // Case 2: [1, 4 + C, N] - Standard Ultralytics YOLO head (e.g. [1, 5, 2100])
+  if (dims.length === 3 && dim1 >= 5) {
+    const channels = dim1;
+    const numAnchors = dim2;
+    const numClasses = channels - 4;
+
+    for (let a = 0; a < numAnchors; a++) {
+      let maxClassScore = 0;
+      let bestClass = 0;
+      for (let c = 0; c < numClasses; c++) {
+        const s = getVal((4 + c) * numAnchors + a);
+        if (s > maxClassScore) {
+          maxClassScore = s;
+          bestClass = c;
+        }
+      }
+
+      if (maxClassScore >= minScore) {
+        const cx = getVal(0 * numAnchors + a);
+        const cy = getVal(1 * numAnchors + a);
+        const w = getVal(2 * numAnchors + a);
+        const h = getVal(3 * numAnchors + a);
+
+        const bx1 = cx - w / 2;
+        const by1 = cy - h / 2;
+        const bx2 = cx + w / 2;
+        const by2 = cy + h / 2;
+
+        const frameBox = unletterboxBox([bx1, by1, bx2, by2], meta);
+        detections.push({ box: frameBox, score: maxClassScore, classId: bestClass });
+      }
+    }
+    detections.sort((a, b) => b.score - a.score);
+    return detections;
+  }
+
+  // Case 3: [1, N, 4 + C]
+  if (dims.length === 3 && dim2 >= 5) {
+    const numDets = dim1;
+    const stride = dim2;
+    const numClasses = stride - 4;
+
+    for (let i = 0; i < numDets; i++) {
+      const offset = i * stride;
+      let maxClassScore = 0;
+      let bestClass = 0;
+      for (let c = 0; c < numClasses; c++) {
+        const s = getVal(offset + 4 + c);
+        if (s > maxClassScore) {
+          maxClassScore = s;
+          bestClass = c;
+        }
+      }
+
