+"use client";
+
+/**
+ * R22B B7.2: Developer Camera Controls Panel (`?camdev=1`, default OFF).
+ *
+ * Inspects `MediaStreamTrack.getCapabilities()` and allows safe, `try/catch`-guarded adjustments to
+ * supported UVC controls (`exposureMode`, `exposureCompensation`, `brightness`, `contrast`).
+ * Every change logs `CAMERA_SETTING_CHANGED{before, after}` to the active benchmark session.
+ */
+import { useEffect, useRef, useState } from "react";
+import { probeCameraExposureCapabilities, type CameraExposureCapabilities } from "./r20-lowlight";
+
+export interface CamDevSettingChange {
+  setting: string;
+  before: Record<string, unknown>;
+  after: Record<string, unknown>;
+}
+
+interface InitialCamSettings {
+  exposureMode: string | null;
+  exposureCompensation: number | null;
+  brightness: number | null;
+  contrast: number | null;
+}
+
+export function CamDevPanel({
+  track,
+  capabilities,
+  onCapabilitiesChange,
+  onSettingChanged,
+}: {
+  track: MediaStreamTrack | null;
+  capabilities: CameraExposureCapabilities | null;
+  onCapabilitiesChange: (next: CameraExposureCapabilities) => void;
+  onSettingChanged: (change: CamDevSettingChange) => void;
+}) {
+  const [statusMsg, setStatusMsg] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+  const initialRef = useRef<{ trackId: string; settings: InitialCamSettings } | null>(null);
+
+  useEffect(() => {
+    if (!track || !capabilities) {
+      initialRef.current = null;
+      return;
+    }
+    const tid = track.id || "primary-track";
+    if (!initialRef.current || initialRef.current.trackId !== tid) {
+      initialRef.current = {
+        trackId: tid,
+        settings: {
+          exposureMode: capabilities.currentExposureMode,
+          exposureCompensation: capabilities.currentExposureCompensation,
+          brightness: capabilities.currentBrightness,
+          contrast: capabilities.currentContrast,
+        },
+      };
+    }
+  }, [track, capabilities]);
+
+  const applySetting = async (
+    setting: string,
+    constraint: Record<string, unknown>,
+  ): Promise<void> => {
+    if (!track || typeof track.applyConstraints !== "function") {
+      setStatusMsg("Track kamera tidak mendukung applyConstraints().");
+      return;
+    }
+    setBusy(true);
+    setStatusMsg(null);
+    const beforeCaps = probeCameraExposureCapabilities(track);
+    const before = {
+      exposureMode: beforeCaps.currentExposureMode,
+      exposureCompensation: beforeCaps.currentExposureCompensation,
+      brightness: beforeCaps.currentBrightness,
+      contrast: beforeCaps.currentContrast,
+    };
+    try {
+      await track.applyConstraints({
+        advanced: [constraint as MediaTrackConstraintSet],
+      });
+      const afterCaps = probeCameraExposureCapabilities(track);
+      const after = {
+        exposureMode: afterCaps.currentExposureMode,
+        exposureCompensation: afterCaps.currentExposureCompensation,
+        brightness: afterCaps.currentBrightness,
+        contrast: afterCaps.currentContrast,
+      };
+      onCapabilitiesChange(afterCaps);
+      onSettingChanged({ setting, before, after });
+      setStatusMsg(`Pengaturan ${setting} diperbarui.`);
+    } catch (err) {
+      const msg = err instanceof Error ? err.message : String(err);
+      setStatusMsg(`Gagal menerapkan ${setting}: ${msg}`);
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const handleReset = async () => {
+    const init = initialRef.current?.settings;
+    if (!init || !track) return;
+    const patch: Record<string, unknown> = {};
+    if (init.exposureMode !== null) patch.exposureMode = init.exposureMode;
+    if (init.exposureCompensation !== null) patch.exposureCompensation = init.exposureCompensation;
+    if (init.brightness !== null) patch.brightness = init.brightness;
+    if (init.contrast !== null) patch.contrast = init.contrast;
+    if (Object.keys(patch).length === 0) {
+      setStatusMsg("Tidak ada pengaturan awal yang dapat dipulihkan.");
+      return;
+    }
+    await applySetting("reset", patch);
+  };
+
+  const hasAnyControl = Boolean(
+    capabilities &&
+      (capabilities.exposureMode?.length ||
+        capabilities.exposureCompensation ||
+        capabilities.brightness ||
+        capabilities.contrast),
+  );
+
+  return (
+    <section
+      className="nui-lab__panel nui-lab__dev-panel"
+      data-testid="camdev-panel"
+      aria-label="Kontrol kamera pengembang (UVC)"
+    >
+      <div className="nui-lab__info-head">
+        <h3>Kontrol Kamera UVC (?camdev=1)</h3>
+        <button
+          type="button"
+          className="nui-lab__button nui-lab__button--compact"
+          data-testid="camdev-reset-btn"
+          disabled={!track || !hasAnyControl || busy}
+          onClick={() => void handleReset()}
+        >
+          Reset ke default
+        </button>
+      </div>
+
+      {!track || !capabilities ? (
+        <p className="nui-lab__muted">Nyalakan kamera untuk memeriksa kapabilitas eksposur / brightness / contrast.</p>
+      ) : !capabilities.hasGetCapabilities ? (
+        <p className="nui-lab__muted">Browser/driver kamera tidak mendukung MediaStreamTrack.getCapabilities().</p>
+      ) : !hasAnyControl ? (
+        <p className="nui-lab__muted">
+          Kapabilitas kamera terdeteksi, tetapi driver tidak menyediakan kontrol exposureMode, exposureCompensation,
+          brightness, atau contrast.
+        </p>
+      ) : (
+        <div className="nui-lab__dev-controls">
+          {capabilities.exposureMode && capabilities.exposureMode.length > 0 && (
+            <div className="nui-lab__dev-row">
+              <span>
+                Mode eksposur: <strong>{capabilities.currentExposureMode ?? "—"}</strong>
+              </span>
+              <div className="nui-lab__row">
+                {capabilities.exposureMode.map((mode) => (
+                  <button
+                    key={mode}
+                    type="button"
+                    className="nui-lab__button nui-lab__button--compact"
+                    aria-pressed={capabilities.currentExposureMode === mode}
+                    disabled={busy}
+                    onClick={() => void applySetting("exposureMode", { exposureMode: mode })}
+                  >
+                    {mode}
+                  </button>
+                ))}
+              </div>
+            </div>
+          )}
+
+          {capabilities.exposureCompensation && (
+            <label className="nui-lab__dev-slider">
+              <span>
+                Kompensasi eksposur:{" "}
+                <strong>
+                  {capabilities.currentExposureCompensation !== null
+                    ? capabilities.currentExposureCompensation.toFixed(2)
+                    : "—"}
+                </strong>{" "}
+                ({capabilities.exposureCompensation.min} .. {capabilities.exposureCompensation.max})
+              </span>
+              <input
+                type="range"
+                min={capabilities.exposureCompensation.min}
+                max={capabilities.exposureCompensation.max}
+                step={capabilities.exposureCompensation.step || 0.1}
+                value={capabilities.currentExposureCompensation ?? capabilities.exposureCompensation.min}
+                disabled={busy}
+                onChange={(e) =>
+                  void applySetting("exposureCompensation", { exposureCompensation: Number(e.target.value) })
+                }
+              />
+            </label>
+          )}
+
+          {capabilities.brightness && (
+            <label className="nui-lab__dev-slider">
+              <span>
+                Brightness:{" "}
+                <strong>{capabilities.currentBrightness !== null ? capabilities.currentBrightness.toFixed(1) : "—"}</strong>{" "}
+                ({capabilities.brightness.min} .. {capabilities.brightness.max})
+              </span>
+              <input
+                type="range"
+                min={capabilities.brightness.min}
+                max={capabilities.brightness.max}
+                step={capabilities.brightness.step || 1}
+                value={capabilities.currentBrightness ?? capabilities.brightness.min}
+                disabled={busy}
+                onChange={(e) => void applySetting("brightness", { brightness: Number(e.target.value) })}
+              />
+            </label>
+          )}
+
+          {capabilities.contrast && (
+            <label className="nui-lab__dev-slider">
+              <span>
+                Contrast:{" "}
+                <strong>{capabilities.currentContrast !== null ? capabilities.currentContrast.toFixed(1) : "—"}</strong>{" "}
+                ({capabilities.contrast.min} .. {capabilities.contrast.max})
+              </span>
+              <input
+                type="range"
+                min={capabilities.contrast.min}
+                max={capabilities.contrast.max}
+                step={capabilities.contrast.step || 1}
+                value={capabilities.currentContrast ?? capabilities.contrast.min}
+                disabled={busy}
+                onChange={(e) => void applySetting("contrast", { contrast: Number(e.target.value) })}
+              />
+            </label>
+          )}
+        </div>
+      )}
+
+      {statusMsg && (
+        <p className="nui-lab__muted" role="status" data-testid="camdev-status">
+          {statusMsg}
+        </p>
+      )}
+    </section>
+  );
+}
diff --git a/frontend/implementation/src/components/nui-lab/bench/GuidedCapturePanel.tsx b/frontend/implementation/src/components/nui-lab/bench/GuidedCapturePanel.tsx
new file mode 100644
index 0000000..af07a78
--- /dev/null
+++ b/frontend/implementation/src/components/nui-lab/bench/GuidedCapturePanel.tsx
@@ -0,0 +1,393 @@
+"use client";
+
+/**
+ * R22B B2.5 & §7: Guided Capture Mode Panel (`?capture=1`, default OFF).
+ *
+ * Guides the Owner through the exact §7 protocol (12 classes × 6 variations + 7 transition drills +
+ * short left-hand round, or P2 short protocol) while tagging every recorded benchmark frame with
+ * `labelSource = "DATASET_GT"`, `labelProvenance = "guided-capture-v1"`, `captureStep`, `variation`,
+ * `lighting`, `subjectCode` (non-PII `P1` | `P2`), and automatic edge masking (`truthMasked = true`
+ * for the first 700 ms and last 300 ms of each prompt step).
+ */
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import {
+  buildGuidedCaptureSteps,
+  GUIDED_CAPTURE_PROVENANCE,
+  GUIDED_MASK_END_MS,
+  GUIDED_MASK_START_MS,
+  isGuidedCaptureFrameMasked,
+  type ActiveCaptureFrameTag,
+  type CaptureLightingCondition,
+  type CaptureProtocolId,
+  type CaptureSubjectCode,
+} from "./guided-capture-protocol";
+
+export interface GuidedCaptureMetaSnapshot {
+  enabled: boolean;
+  protocolId: CaptureProtocolId;
+  subjectCode: CaptureSubjectCode;
+  lighting: CaptureLightingCondition;
+  provenance: typeof GUIDED_CAPTURE_PROVENANCE;
+}
+
+export function GuidedCapturePanel({
+  cameraRunning,
+  onTagProviderChange,
+  onStepEvent,
+  onMetaChange,
+}: {
+  cameraRunning: boolean;
+  onTagProviderChange: (provider: ((nowMs: number) => ActiveCaptureFrameTag | null) | null) => void;
+  onStepEvent: (
+    kind: "CAPTURE_STEP_START" | "CAPTURE_STEP_END",
+    detail: Record<string, string | number | boolean | null>,
+  ) => void;
+  onMetaChange: (meta: GuidedCaptureMetaSnapshot | null) => void;
+}) {
+  const [protocol, setProtocol] = useState<CaptureProtocolId>("p1-full");
+  const [subjectCode, setSubjectCode] = useState<CaptureSubjectCode>("P1");
+  const [lighting, setLighting] = useState<CaptureLightingCondition>("B-lampu-depan-nyala");
+  const [stepIndex, setStepIndex] = useState(0);
+  const [active, setActive] = useState(false);
+  const [elapsedMs, setElapsedMs] = useState(0);
+  const [completedCount, setCompletedCount] = useState(0);
+
+  const steps = useMemo(() => buildGuidedCaptureSteps(protocol), [protocol]);
+  const currentStep = steps[Math.min(stepIndex, Math.max(0, steps.length - 1))] ?? null;
+
+  const stepStartPerfRef = useRef<number | null>(null);
+  const activeRef = useRef(active);
+  activeRef.current = active;
+  const stepRef = useRef(currentStep);
+  stepRef.current = currentStep;
+  const subjectRef = useRef(subjectCode);
+  subjectRef.current = subjectCode;
+  const lightingRef = useRef(lighting);
+  lightingRef.current = lighting;
+
+  useEffect(() => {
+    onMetaChange({
+      enabled: true,
+      protocolId: protocol,
+      subjectCode,
+      lighting,
+      provenance: GUIDED_CAPTURE_PROVENANCE,
+    });
+    return () => onMetaChange(null);
+  }, [protocol, subjectCode, lighting, onMetaChange]);
+
+  const emitStepStart = useCallback(
+    (idx: number) => {
+      const st = steps[idx];
+      if (!st) return;
+      onStepEvent("CAPTURE_STEP_START", {
+        stepIndex: idx,
+        totalSteps: steps.length,
+        captureStep: st.id,
+        truthLabel: st.truthLabel,
+        variation: st.variation,
+        durationMs: st.durationMs,
+        lighting: lightingRef.current,
+        subjectCode: subjectRef.current,
+        labelProvenance: GUIDED_CAPTURE_PROVENANCE,
+      });
+    },
+    [steps, onStepEvent],
+  );
+
+  const emitStepEnd = useCallback(
+    (idx: number, outcome: "completed" | "paused" | "redone" | "skipped" | "stopped") => {
+      const st = steps[idx];
+      if (!st) return;
+      onStepEvent("CAPTURE_STEP_END", {
+        stepIndex: idx,
+        captureStep: st.id,
+        truthLabel: st.truthLabel,
+        variation: st.variation,
+        outcome,
+        lighting: lightingRef.current,
+        subjectCode: subjectRef.current,
+      });
+    },
+    [steps, onStepEvent],
+  );
+
+  // Expose live millisecond-exact frame tag provider to NuiLabPage without per-frame React re-renders.
+  useEffect(() => {
+    if (!active) {
+      onTagProviderChange(null);
+      return;
+    }
+    const provider = (nowMs: number): ActiveCaptureFrameTag | null => {
+      const st = stepRef.current;
+      const t0 = stepStartPerfRef.current;
+      if (!activeRef.current || !st || t0 === null) return null;
+      const elapsed = Math.max(0, nowMs - t0);
+      return {
+        truth: st.truthLabel,
+        truthMasked: isGuidedCaptureFrameMasked(elapsed, st.durationMs),
+        labelProvenance: GUIDED_CAPTURE_PROVENANCE,
+        captureStep: st.id,
+        variation: st.variation,
+        lighting: lightingRef.current,
+        subjectCode: subjectRef.current,
+      };
+    };
+    onTagProviderChange(provider);
+    return () => onTagProviderChange(null);
+  }, [active, onTagProviderChange]);
+
+  // Step timer & auto-advance.
+  useEffect(() => {
+    if (!active || !currentStep) return;
+    if (stepStartPerfRef.current === null) {
+      stepStartPerfRef.current = performance.now();
+    }
+    const id = setInterval(() => {
+      const t0 = stepStartPerfRef.current;
+      if (t0 === null || !stepRef.current) return;
+      const el = Math.max(0, performance.now() - t0);
+      if (el >= stepRef.current.durationMs) {
+        emitStepEnd(stepIndex, "completed");
+        setCompletedCount((c) => c + 1);
+        if (stepIndex + 1 < steps.length) {
+          const nextIdx = stepIndex + 1;
+          stepStartPerfRef.current = performance.now();
+          setStepIndex(nextIdx);
+          setElapsedMs(0);
+          emitStepStart(nextIdx);
+        } else {
+          stepStartPerfRef.current = null;
+          setActive(false);
+          setElapsedMs(stepRef.current.durationMs);
+        }
+      } else {
+        setElapsedMs(el);
+      }
+    }, 100);
+    return () => clearInterval(id);
+  }, [active, currentStep, stepIndex, steps.length, emitStepEnd, emitStepStart]);
+
+  // Pause automatically if camera turns off.
+  useEffect(() => {
+    if (!cameraRunning && active) {
+      emitStepEnd(stepIndex, "stopped");
+      stepStartPerfRef.current = null;
+      setActive(false);
+      setElapsedMs(0);
+    }
+  }, [cameraRunning, active, stepIndex, emitStepEnd]);
+
+  const handleStartOrPause = () => {
+    if (!currentStep) return;
+    if (active) {
+      emitStepEnd(stepIndex, "paused");
+      stepStartPerfRef.current = null;
+      setActive(false);
+      return;
+    }
+    stepStartPerfRef.current = performance.now();
+    setElapsedMs(0);
+    setActive(true);
+    emitStepStart(stepIndex);
+  };
+
+  const handleRedoStep = () => {
+    if (!currentStep) return;
+    if (active) emitStepEnd(stepIndex, "redone");
+    stepStartPerfRef.current = performance.now();
+    setElapsedMs(0);
+    setActive(true);
+    emitStepStart(stepIndex);
+  };
+
+  const handleJump = (delta: number) => {
+    const nextIdx = Math.max(0, Math.min(steps.length - 1, stepIndex + delta));
+    if (nextIdx === stepIndex) return;
+    if (active) emitStepEnd(stepIndex, "skipped");
+    setStepIndex(nextIdx);
+    setElapsedMs(0);
+    if (active) {
+      stepStartPerfRef.current = performance.now();
+      emitStepStart(nextIdx);
+    } else {
+      stepStartPerfRef.current = null;
+    }
+  };
+
+  const handleProtocolSwitch = (nextProto: CaptureProtocolId) => {
+    if (active) {
+      emitStepEnd(stepIndex, "stopped");
+      setActive(false);
+      stepStartPerfRef.current = null;
+    }
+    setProtocol(nextProto);
+    setStepIndex(0);
+    setElapsedMs(0);
+    setCompletedCount(0);
+  };
+
+  const remainingSec = currentStep ? Math.max(0, (currentStep.durationMs - elapsedMs) / 1000) : 0;
+  const maskedNow = currentStep ? isGuidedCaptureFrameMasked(elapsedMs, currentStep.durationMs) : true;
+  const pct = currentStep ? Math.min(100, Math.round((elapsedMs / Math.max(1, currentStep.durationMs)) * 100)) : 0;
+
+  return (
+    <section
+      className="nui-lab__panel nui-lab__dev-panel nui-lab__capture-panel"
+      data-testid="guided-capture-panel"
+      aria-label="Mode Pengambilan Data Terpandu (Guided Capture)"
+    >
+      <div className="nui-lab__info-head">
+        <h3>Guided Capture Dataset GT (?capture=1)</h3>
+        <span className={`nui-lab__pill ${active ? (maskedNow ? "nui-lab__pill--warn" : "nui-lab__pill--ok") : ""}`}>
+          {active
+            ? maskedNow
+              ? `MASKED (awal ${GUIDED_MASK_START_MS}ms / akhir ${GUIDED_MASK_END_MS}ms)`
+              : "REKAM DATASET_GT AKTIF"
+            : "SIAP / JEDA"}
+        </span>
+      </div>
+
+      <div className="nui-lab__capture-meta-bar">
+        <div className="nui-lab__row">
+          <span className="nui-lab__muted">Subjek (non-PII):</span>
+          {(["P1", "P2"] as const).map((code) => (
+            <button
+              key={code}
+              type="button"
+              className="nui-lab__button nui-lab__button--compact"
+              aria-pressed={subjectCode === code}
+              disabled={active}
+              onClick={() => setSubjectCode(code)}
+            >
+              {code}
+            </button>
+          ))}
+        </div>
+
+        <div className="nui-lab__row">
+          <span className="nui-lab__muted">Pencahayaan:</span>
+          {(
+            [
+              { id: "A-lampu-depan-mati", label: "A: Lampu depan mati" },
+              { id: "B-lampu-depan-nyala", label: "B: Lampu depan nyala" },
+            ] as const
+          ).map((opt) => (
+            <button
+              key={opt.id}
+              type="button"
+              className="nui-lab__button nui-lab__button--compact"
+              aria-pressed={lighting === opt.id}
+              disabled={active}
+              onClick={() => setLighting(opt.id)}
+            >
+              {opt.label}
+            </button>
+          ))}
+        </div>
+
+        <div className="nui-lab__row">
+          <span className="nui-lab__muted">Protokol:</span>
+          <button
+            type="button"
+            className="nui-lab__button nui-lab__button--compact"
+            aria-pressed={protocol === "p1-full"}
+            disabled={active}
+            onClick={() => handleProtocolSwitch("p1-full")}
+          >
+            P1 Penuh (12×6 + 7 drill + kiri)
+          </button>
+          <button
+            type="button"
+            className="nui-lab__button nui-lab__button--compact"
+            aria-pressed={protocol === "p2-short"}
+            disabled={active}
+            onClick={() => handleProtocolSwitch("p2-short")}
+          >
+            P2 Ringkas (12×3 + 7 drill)
+          </button>
+          <button
+            type="button"
+            className="nui-lab__button nui-lab__button--compact"
+            aria-pressed={protocol === "p2-mini"}
+            disabled={active}
+            onClick={() => handleProtocolSwitch("p2-mini")}
+          >
+            P2 Mini (±4 menit, 19 langkah)
+          </button>
+        </div>
+      </div>
+
+      {currentStep && (
+        <div className="nui-lab__capture-prompt" data-testid="guided-capture-prompt" data-masked={maskedNow ? "true" : "false"}>
+          <div className="nui-lab__info-head">
+            <span className="nui-lab__eyebrow">
+              LANGKAH {stepIndex + 1} / {steps.length} · {currentStep.phase.toUpperCase()} · LABEL{" "}
+              <code>{currentStep.truthLabel}</code>
+            </span>
+            <strong className="nui-lab__capture-countdown" data-testid="guided-capture-countdown">
+              {remainingSec.toFixed(1)} dtk
+            </strong>
+          </div>
+          <div className="nui-lab__capture-title">{currentStep.title}</div>
+          <div className="nui-lab__capture-variation">Variasi: {currentStep.variationLabel}</div>
+          <p className="nui-lab__status">{currentStep.instruction}</p>
+          <div
+            className="nui-lab__progress"
+            role="progressbar"
+            aria-label="Progres langkah pengambilan data"
+            aria-valuemin={0}
+            aria-valuemax={100}
+            aria-valuenow={pct}
+          >
+            <div className="nui-lab__progress-fill" style={{ width: `${pct}%` }} />
+          </div>
+        </div>
+      )}
+
+      <div className="nui-lab__row">
+        <button
+          type="button"
+          className="nui-lab__button nui-lab__button--primary nui-lab__button--compact"
+          data-testid="guided-capture-start-btn"
+          disabled={!cameraRunning || !currentStep}
+          onClick={handleStartOrPause}
+        >
+          {active ? "Jeda langkah" : "Mulai rekam langkah"}
+        </button>
+        <button
+          type="button"
+          className="nui-lab__button nui-lab__button--compact"
+          data-testid="guided-capture-redo-btn"
+          disabled={!cameraRunning || !currentStep}
+          onClick={handleRedoStep}
+        >
+          Ulangi langkah
+        </button>
+        <button
+          type="button"
+          className="nui-lab__button nui-lab__button--compact"
+          disabled={stepIndex <= 0}
+          onClick={() => handleJump(-1)}
+        >
+          ← Sebelumnya
+        </button>
+        <button
+          type="button"
+          className="nui-lab__button nui-lab__button--compact"
+          disabled={stepIndex >= steps.length - 1}
+          onClick={() => handleJump(1)}
+        >
+          Berikutnya →
+        </button>
+      </div>
+
+      <p className="nui-lab__muted">
+        Selesai: {completedCount} langkah · Provenance: <code>{GUIDED_CAPTURE_PROVENANCE}</code> ·{" "}
+        {cameraRunning
+          ? "Semua frame saat aktif ditandai DATASET_GT (awal 700 ms & akhir 300 ms otomatis masked)."
+          : "Nyalakan kamera terlebih dahulu untuk mulai merekam."}
+      </p>
+    </section>
+  );
+}
diff --git a/frontend/implementation/src/components/nui-lab/bench/RawVideoRecorder.tsx b/frontend/implementation/src/components/nui-lab/bench/RawVideoRecorder.tsx
new file mode 100644
index 0000000..4d63949
--- /dev/null
+++ b/frontend/implementation/src/components/nui-lab/bench/RawVideoRecorder.tsx
@@ -0,0 +1,228 @@
+"use client";
+
+/**
+ * R22B B2.6: Developer-Only Local Raw Camera Video Recorder (`?rawrec=1`, default OFF).
+ *
+ * Guarantees:
+ *  - Never shown by default and NEVER exposed to student gameplay.
+ *  - Requires a separate explicit consent checkbox before recording can start.
+ *  - Uses browser `MediaRecorder` locally to save `.webm` to disk — ZERO network uploads.
+ *  - Filenames include `sessionId`, `trialId`, and start timestamp for offline low-light replay (B7.3).
+ *  - Logs `RAWREC_START` and `RAWREC_STOP` events to the benchmark session.
+ */
+import { useCallback, useEffect, useRef, useState } from "react";
+
+export interface RawRecMetaSnapshot {
+  enabled: boolean;
+  consentGranted: boolean;
+  mimeType: string | null;
+  startedAtIso: string | null;
+  filename: string | null;
+}
+
+function pickSupportedWebmMime(): string | null {
+  if (typeof MediaRecorder === "undefined") return null;
+  const candidates = ["video/webm;codecs=vp8", "video/webm;codecs=vp9", "video/webm"];
+  for (const mime of candidates) {
+    if (typeof MediaRecorder.isTypeSupported === "function" && MediaRecorder.isTypeSupported(mime)) {
+      return mime;
+    }
+  }
+  return "";
+}
+
+function sanitizeToken(v: string | null | undefined, fallback: string): string {
+  const clean = (v ?? "").replace(/[^a-zA-Z0-9_-]/g, "");
+  return clean.length > 0 ? clean : fallback;
+}
+
+export function RawVideoRecorder({
+  stream,
+  sessionId,
+  trialId,
+  onRawRecEvent,
+  onMetaChange,
+}: {
+  stream: MediaStream | null;
+  sessionId: string | null;
+  trialId: string | null;
+  onRawRecEvent: (
+    kind: "RAWREC_START" | "RAWREC_STOP",
+    detail: Record<string, string | number | boolean | null>,
+  ) => void;
+  onMetaChange: (meta: RawRecMetaSnapshot | null) => void;
+}) {
+  const [rawConsent, setRawConsent] = useState(false);
+  const [recording, setRecording] = useState(false);
+  const [errorMsg, setErrorMsg] = useState<string | null>(null);
+  const [lastDownload, setLastDownload] = useState<{ url: string; filename: string; bytes: number } | null>(null);
+
+  const recorderRef = useRef<MediaRecorder | null>(null);
+  const chunksRef = useRef<BlobPart[]>([]);
+  const metaRef = useRef<{ filename: string; mimeType: string; startedAtIso: string } | null>(null);
+  const lastUrlRef = useRef<string | null>(null);
+
+  const supported = typeof MediaRecorder !== "undefined";
+
+  const stopRecording = useCallback(
+    (reason: string) => {
+      const rec = recorderRef.current;
+      if (!rec) return;
+      recorderRef.current = null;
+      if (rec.state !== "inactive") {
+        try {
+          rec.stop();
+        } catch {
+          /* ignore */
+        }
+      }
+      setRecording(false);
+      onMetaChange(null);
+      onRawRecEvent("RAWREC_STOP", {
+        reason,
+        filename: metaRef.current?.filename ?? null,
+      });
+    },
+    [onRawRecEvent, onMetaChange],
+  );
+
+  // Stop cleanly if camera stream stops or component unmounts.
+  useEffect(() => {
+    if (!stream && recorderRef.current) {
+      stopRecording("stream-ended");
+    }
+  }, [stream, stopRecording]);
+
+  useEffect(() => {
+    return () => {
+      if (recorderRef.current && recorderRef.current.state !== "inactive") {
+        try {
+          recorderRef.current.stop();
+        } catch {
+          /* ignore */
+        }
+      }
+      if (lastUrlRef.current) {
+        URL.revokeObjectURL(lastUrlRef.current);
+        lastUrlRef.current = null;
+      }
+      onMetaChange(null);
+    };
+  }, [onMetaChange]);
+
+  const startRecording = () => {
+    if (!supported || !stream || !rawConsent) return;
+    setErrorMsg(null);
+    const mime = pickSupportedWebmMime();
+    if (mime === null) {
+      setErrorMsg("MediaRecorder tidak didukung di browser ini.");
+      return;
+    }
+    const startedAtIso = new Date().toISOString();
+    const compactTs = startedAtIso.replace(/[:.]/g, "-").slice(0, 19);
+    const filename = `nui-rawrec_${sanitizeToken(sessionId, "nosession")}_${sanitizeToken(trialId, "notrial")}_${compactTs}.webm`;
+    try {
+      const options: MediaRecorderOptions = mime ? { mimeType: mime } : {};
+      const rec = new MediaRecorder(stream, options);
+      chunksRef.current = [];
+      metaRef.current = { filename, mimeType: rec.mimeType || mime || "video/webm", startedAtIso };
+      rec.ondataavailable = (ev) => {
+        if (ev.data && ev.data.size > 0) chunksRef.current.push(ev.data);
+      };
+      rec.onstop = () => {
+        const meta = metaRef.current;
+        const blob = new Blob(chunksRef.current, { type: meta?.mimeType || "video/webm" });
+        chunksRef.current = [];
+        if (lastUrlRef.current) URL.revokeObjectURL(lastUrlRef.current);
+        const url = URL.createObjectURL(blob);
+        lastUrlRef.current = url;
+        const fname = meta?.filename ?? `nui-rawrec_${compactTs}.webm`;
+        setLastDownload({ url, filename: fname, bytes: blob.size });
+        try {
+          const a = document.createElement("a");
+          a.href = url;
+          a.download = fname;
+          document.body.appendChild(a);
+          a.click();
+          a.remove();
+        } catch {
+          /* download link stays available below */
+        }
+      };
+      rec.start(1000);
+      recorderRef.current = rec;
+      setRecording(true);
+      onMetaChange({
+        enabled: true,
+        consentGranted: true,
+        mimeType: metaRef.current.mimeType,
+        startedAtIso,
+        filename,
+      });
+      onRawRecEvent("RAWREC_START", {
+        filename,
+        mimeType: metaRef.current.mimeType,
+        startedAtIso,
+      });
+    } catch (err) {
+      setErrorMsg(err instanceof Error ? err.message : String(err));
+    }
+  };
+
+  return (
+    <section
+      className="nui-lab__panel nui-lab__dev-panel nui-lab__rawrec-panel"
+      data-testid="rawrec-panel"
+      aria-label="Perekam video mentah lokal (khusus pengembang)"
+    >
+      <div className="nui-lab__info-head">
+        <h3>Rekam Video Kamera Mentah (?rawrec=1)</h3>
+        <span className={`nui-lab__pill ${recording ? "nui-lab__pill--err" : ""}`}>
+          {recording ? "MEREKAM LOKAL (.webm)" : "NONAKTIF"}
+        </span>
+      </div>
+
+      <label className="nui-lab__check">
+        <input
+          type="checkbox"
+          data-testid="rawrec-consent-checkbox"
+          checked={rawConsent}
+          disabled={recording}
+          onChange={(e) => setRawConsent(e.target.checked)}
+        />
+        <span>Rekam video kamera mentah (khusus pengembang, lokal, tidak diunggah)</span>
+      </label>
+
+      <p className="nui-lab__muted">
+        Video hanya diunduh ke komputer Anda (<code>.webm</code>) untuk replay offline low-light dan{" "}
+        <strong>tidak pernah diunggah</strong>. Jangan aktifkan saat mengukur benchmark performa A/B.
+      </p>
+
+      <div className="nui-lab__row">
+        <button
+          type="button"
+          className={`nui-lab__button nui-lab__button--compact ${recording ? "" : "nui-lab__button--primary"}`}
+          data-testid="rawrec-toggle-btn"
+          disabled={!supported || !stream || (!recording && !rawConsent)}
+          onClick={() => (recording ? stopRecording("user-stop") : startRecording())}
+        >
+          {recording ? "Hentikan & Unduh WebM" : "Mulai Rekam Video Lokal"}
+        </button>
+
+        {lastDownload && (
+          <a
+            href={lastDownload.url}
+            download={lastDownload.filename}
+            className="nui-lab__button nui-lab__button--compact"
+            data-testid="rawrec-download-link"
+          >
+            Unduh ulang ({Math.max(1, Math.round(lastDownload.bytes / 1024))} KB)
+          </a>
+        )}
+      </div>
+
+      {!supported && <p className="nui-lab__status nui-lab__status--error">MediaRecorder tidak tersedia di browser ini.</p>}
+      {errorMsg && <p className="nui-lab__status nui-lab__status--error">{errorMsg}</p>}
+    </section>
+  );
+}
