+
+    // 900 ms < 1000 ms -> still OFF
+    r = hys.update({ nowMs: 900, handRoiLumaP50: null, lumaP50: 0.12 });
+    expect(r.active).toBe(false);
+    expect(r.transition).toBeNull();
+
+    // 1050 ms >= 1000 ms -> transitions ON
