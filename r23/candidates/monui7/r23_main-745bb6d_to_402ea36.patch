+export function mapK4v11ToV10Class(cls: K4DerivedClass): "FIST" | "ONE" | "TWO" | "FIVE" | "PINCH" | "OTHER" {
+  switch (cls) {
+    case "FIST":
+    case "ONE":
+    case "TWO":
+    case "FIVE":
