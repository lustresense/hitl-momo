+    expect(r.active).toBe(true);
+    expect(r.transition).toBe("ON");
+    expect(r.status.onCount).toBe(1);
+
+    // Inside hysteresis dead-band [0.15, 0.22] -> MUST stay ON even for > 5 seconds
