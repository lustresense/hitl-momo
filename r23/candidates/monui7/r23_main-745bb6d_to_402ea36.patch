+      actionAccepted: false,
+      rejectReason: null,
+      labelSource: "RULE_DERIVED",
+      fingerCount: 0,
+      poseClass: "OTHER",
+      handPose: "none",
+      pinchState: "OPEN",
+      pinchRatio: null,
+      pinchContact: false,
+      pinchVariant: null,
+      pinchGate: { ...EMPTY_PINCH_GATE },
+      pinchOnset: "NONE",
+      handState: { ...EMPTY_HAND_STATE },
