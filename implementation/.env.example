# DEV/PUBLIC configuration only — NO secrets in this project.
# Prediction source: "mock" (default, deterministic dev fixtures) or "partner".
NEXT_PUBLIC_PREDICTION_MODE=mock
# Partner classifier endpoint consumed client-side via PartnerHttpPredictionProvider.
# Leave empty until the partner contract exists. No Next proxy route is used.
NEXT_PUBLIC_PREDICTION_ENDPOINT=
# Partner request timeout (ms).
NEXT_PUBLIC_PREDICTION_TIMEOUT_MS=8000
# Default drawing input mode: "pointer" (mouse/touch) or "hand" (MediaPipe, provisional).
NEXT_PUBLIC_DRAW_INPUT_MODE=pointer
# HandLandmarker model asset. Local bundled copy preferred; public CDN fallback allowed.
NEXT_PUBLIC_MEDIAPIPE_MODEL_URL=/models/hand_landmarker.task
# Enables browser test hooks (__skbTestHooks) for automated E2E. Never enable in production.
NEXT_PUBLIC_TEST_HOOKS=0
