+  { id: "palm", label: "Telapak menghadap kamera" },
+  { id: "back", label: "Punggung tangan menghadap kamera" },
+  { id: "side", label: "Menyamping 45°" },
+  { id: "moving", label: "Bergerak pelan kiri–kanan" },
