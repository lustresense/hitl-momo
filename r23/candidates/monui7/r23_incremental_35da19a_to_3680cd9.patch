+      effectiveLuma = input.handRoiLumaP50;
+      lumaSource = "handRoiLumaP50";
+    } else if (
+      input.lumaP50 !== null &&
+      input.lumaP50 !== undefined &&
+      Number.isFinite(input.lumaP50)
