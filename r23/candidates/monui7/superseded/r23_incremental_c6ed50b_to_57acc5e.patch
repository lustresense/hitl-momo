index 0000000000000000000000000000000000000000..c2e3be258862c4276226f804fe97b5a36ee3248c
--- /dev/null
+++ b/frontend/implementation/tests/nui-lab/monui7-momo-guide.test.ts
@@ -0,0 +1,168 @@
+import { describe, expect, it } from "vitest";
+import {
+  MomoGuideFSM,
+  MOMO_GUIDE_CONSTANTS,
+  MOMO_GUIDE_TEXTS,
+} from "@/src/components/nui-lab/bench/monui7-momo-guide";
+
+describe("MoNUI-7 MomoGuideFSM (Lampiran B)", () => {
+  it("starts in GREET with initial greeting text and ink disabled", () => {
+    const guide = new MomoGuideFSM();
+    expect(guide.state).toBe("GREET");
+    expect(guide.text).toBe("Halo! Tunjukkan lima jarimu ke aku dulu, ya.");
+    expect(guide.isInkAllowed).toBe(false);
+  });
+
+  it("transitions from GREET to LOCKED after FIVE is held stably for >= 300 ms", () => {
+    const guide = new MomoGuideFSM();
+
+    // 0 ms: five starts
+    let res = guide.update({ nowMs: 0, hasHand: true, fiveFingerValid: true });
+    expect(res.state).toBe("GREET");
+    expect(res.inkAllowed).toBe(false);
+
+    // 200 ms: not yet 300 ms
+    res = guide.update({ nowMs: 200, hasHand: true, fiveFingerValid: true });
+    expect(res.state).toBe("GREET");
+    expect(res.inkAllowed).toBe(false);
+
+    // 350 ms: >= 300 ms -> LOCKED
+    res = guide.update({ nowMs: 350, hasHand: true, fiveFingerValid: true });
+    expect(res.state).toBe("LOCKED");
+    expect(res.text).toBe("Sip, aku sudah lihat tanganmu. Silakan menggambar!");
+    expect(res.inkAllowed).toBe(true);
+    expect(res.promptEvent?.state).toBe("LOCKED");
+  });
+
+  it("transitions from LOCKED to DRAWING on drawingActive, hiding the speech bubble", () => {
+    const guide = new MomoGuideFSM("LOCKED");
+    expect(guide.state).toBe("LOCKED");
+    expect(guide.isInkAllowed).toBe(true);
+
+    const res = guide.update({
+      nowMs: 1000,
+      hasHand: true,
+      fiveFingerValid: false,
+      drawingActive: true,
+    });
+
+    expect(res.state).toBe("DRAWING");
+    expect(res.text).toBeNull();
+    expect(res.inkAllowed).toBe(true);
+    expect(res.promptEvent).toBeNull();
+  });
+
+  it("transitions from DRAWING or LOCKED to ASK_FIVE_AGAIN when hand is lost >= 2000 ms or rescueState=LOST", () => {
+    const guide = new MomoGuideFSM("DRAWING");
+    guide.update({ nowMs: 500, hasHand: true, fiveFingerValid: false, drawingActive: true });
+
+    // Hand lost for 1000 ms -> still DRAWING
+    let res = guide.update({ nowMs: 1500, hasHand: false, fiveFingerValid: false });
+    expect(res.state).toBe("DRAWING");
+
+    // Hand lost for 2600 ms -> ASK_FIVE_AGAIN
+    res = guide.update({ nowMs: 3100, hasHand: false, fiveFingerValid: false });
+    expect(res.state).toBe("ASK_FIVE_AGAIN");
+    expect(res.text).toBe("Tanganmu hilang dari pandanganku. Tunjukkan lima jari lagi, ya.");
+    expect(res.inkAllowed).toBe(false);
+
+    // Test immediate LOST via rescueState
+    const guide2 = new MomoGuideFSM("LOCKED");
+    const res2 = guide2.update({
+      nowMs: 100,
+      hasHand: false,
+      fiveFingerValid: false,
+      rescueState: "LOST",
+    });
+    expect(res2.state).toBe("ASK_FIVE_AGAIN");
+    expect(res2.inkAllowed).toBe(false);
+  });
+
+  it("transitions to UNCLEAR_FINGERS when rescueState is POSITION_ONLY", () => {
+    const guide = new MomoGuideFSM("LOCKED");
+    const res = guide.update({
+      nowMs: 1000,
+      hasHand: false,
+      fiveFingerValid: false,
+      rescueState: "POSITION_ONLY",
+    });
+
+    expect(res.state).toBe("UNCLEAR_FINGERS");
+    expect(res.text).toBe("Aku lihat tanganmu, tapi jarinya belum jelas. Coba dekatkan sedikit.");
+    expect(res.inkAllowed).toBe(false);
+  });
+
+  it("transitions to ASK_LIGHT on persistent low ROI luma (< 0.10 for >= 3s)", () => {
+    const guide = new MomoGuideFSM("LOCKED");
+
+    // Low luma starts at 0 ms
+    let res = guide.update({
+      nowMs: 0,
+      hasHand: true,
+      fiveFingerValid: false,
+      handRoiLumaP50: 0.08,
+    });
+    expect(res.state).toBe("LOCKED");
+
+    // 2500 ms: not yet 3000 ms
+    res = guide.update({
+      nowMs: 2500,
+      hasHand: true,
+      fiveFingerValid: false,
+      handRoiLumaP50: 0.08,
+    });
+    expect(res.state).toBe("LOCKED");
+
+    // 3200 ms: >= 3000 ms -> ASK_LIGHT
+    res = guide.update({
+      nowMs: 3200,
+      hasHand: true,
+      fiveFingerValid: false,
+      handRoiLumaP50: 0.08,
+    });
+    expect(res.state).toBe("ASK_LIGHT");
+    expect(res.text).toBe("Ruangannya agak gelap. Coba nyalakan lampu di depanmu, ya.");
+    expect(res.inkAllowed).toBe(false);
+  });
+
+  it("transitions to ASK_LIGHT on repeated hand loss in low frame lighting (>= 2 losses in 10s)", () => {
+    const guide = new MomoGuideFSM("LOCKED");
+
+    // Frame luma is 0.15 (< 0.20 threshold)
+    // Loss 1 at 100 ms
+    guide.update({ nowMs: 50, hasHand: true, fiveFingerValid: false, frameLumaMean: 0.15 });
+    guide.update({ nowMs: 100, hasHand: false, fiveFingerValid: false, frameLumaMean: 0.15 });
+
+    // Reacquired briefly
+    guide.update({ nowMs: 500, hasHand: true, fiveFingerValid: false, frameLumaMean: 0.15 });
+
+    // Loss 2 at 1200 ms -> triggers ASK_LIGHT
+    const res = guide.update({
+      nowMs: 1200,
+      hasHand: false,
+      fiveFingerValid: false,
+      frameLumaMean: 0.15,
+    });
+    expect(res.state).toBe("ASK_LIGHT");
+    expect(res.text).toBe("Ruangannya agak gelap. Coba nyalakan lampu di depanmu, ya.");
+    expect(res.inkAllowed).toBe(false);
+  });
+
+  it("recovers from prompt states back to LOCKED after stable FIVE is re-acquired", () => {
+    for (const promptState of ["ASK_FIVE_AGAIN", "UNCLEAR_FINGERS", "ASK_LIGHT"] as const) {
+      const guide = new MomoGuideFSM(promptState);
+      expect(guide.state).toBe(promptState);
+      expect(guide.isInkAllowed).toBe(false);
+
+      // Start FIVE at 100 ms
+      guide.update({ nowMs: 100, hasHand: true, fiveFingerValid: true });
+      expect(guide.state).toBe(promptState);
+
+      // Re-acquired stable >= 300 ms at 450 ms
+      const res = guide.update({ nowMs: 450, hasHand: true, fiveFingerValid: true });
+      expect(res.state).toBe("LOCKED");
+      expect(res.text).toBe("Sip, aku sudah lihat tanganmu. Silakan menggambar!");
+      expect(res.inkAllowed).toBe(true);
+    }
+  });
+});
diff --git a/frontend/implementation/tests/nui-lab/monui7-rescue.test.ts b/frontend/implementation/tests/nui-lab/monui7-rescue.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9be00021754d00359a6be4d90e73c8b8eca0581b
--- /dev/null
+++ b/frontend/implementation/tests/nui-lab/monui7-rescue.test.ts
@@ -0,0 +1,217 @@
+/**
+ * Unit tests for MoNUI-7 Rescue State Machine (`tests/nui-lab/monui7-rescue.test.ts`).
+ *
+ * Enforces T22 & Lampiran A:
+ * - NORMAL -> miss >= 100ms -> SEARCH
+ * - SEARCH -> mpHand present -> NORMAL
+ * - SEARCH -> box >= 0.35 & crop 21 points -> RESCUE_TRACK
+ * - SEARCH -> box present & crop null >= 500ms -> POSITION_ONLY
+ * - SEARCH -> no box & no crop >= 2000ms -> LOST
+ * - RESCUE_TRACK -> mpHand present -> NORMAL
+ * - RESCUE_TRACK -> crop fails 3 times in a row -> SEARCH
+ * - POSITION_ONLY -> crop provides 21 points -> RESCUE_TRACK
+ * - POSITION_ONLY -> mpHand present -> NORMAL
+ * - POSITION_ONLY -> box absent >= 2000ms -> LOST
+ * - LOST -> mpHand present -> NORMAL
+ * - LOST -> box + points present -> RESCUE_TRACK
+ * - Crop square math: scale 1.6, aspect 1:1, clamping to [0, 1]
+ * - Landmark unmapping precision
+ */
+import { describe, expect, it } from "vitest";
+import {
+  CROP_SCALE,
+  LOST_PROMPT_AFTER_MS,
+  POSITION_ONLY_AFTER_MS,
+  RESCUE_ENTER_MISS_MS,
+  RESCUE_TRACK_MAX_FAILS,
+  RescueFSM,
+  YOLO_INTERVAL_MS,
+  YOLO_MIN_SCORE,
+  computeCropSquareFromBox,
+  computeCropSquareFromLandmarks,
+  unmapLandmarksFromCrop,
+} from "../../src/components/nui-lab/bench/monui7-rescue";
+
+function makeDummyPoints(n = 21, base = 0.5): Array<{ x: number; y: number; z: number }> {
+  const pts: Array<{ x: number; y: number; z: number }> = [];
+  for (let i = 0; i < n; i++) {
+    pts.push({ x: base + (i % 5) * 0.02, y: base + Math.floor(i / 5) * 0.02, z: 0 });
+  }
+  return pts;
+}
+
+describe("MoNUI-7 Rescue State Machine (T22 / Lampiran A)", () => {
+  it("exports required prototype constants with exact values", () => {
+    expect(RESCUE_ENTER_MISS_MS).toBe(100);
+    expect(YOLO_INTERVAL_MS).toBe(100);
+    expect(YOLO_MIN_SCORE).toBe(0.35);
+    expect(CROP_SCALE).toBe(1.6);
+    expect(POSITION_ONLY_AFTER_MS).toBe(500);
+    expect(LOST_PROMPT_AFTER_MS).toBe(2000);
+    expect(RESCUE_TRACK_MAX_FAILS).toBe(3);
+  });
+
+  it("transitions NORMAL -> SEARCH after missing hand >= 100ms", () => {
+    const fsm = new RescueFSM("NORMAL");
+    expect(fsm.state).toBe("NORMAL");
+
+    // Frame at t=0: hand missing, but not yet 100ms
+    let res = fsm.update({ t: 0, mpHand: false });
+    expect(res.state).toBe("NORMAL");
+    expect(res.event).toBeNull();
+
+    // Frame at t=50: still NORMAL
+    res = fsm.update({ t: 50, mpHand: false });
+    expect(res.state).toBe("NORMAL");
+
+    // Frame at t=100: reaches 100ms -> transitions to SEARCH
+    res = fsm.update({ t: 100, mpHand: false });
+    expect(res.state).toBe("SEARCH");
+    expect(res.event).toBe("RESCUE_START");
+  });
+
+  it("transitions SEARCH -> NORMAL immediately when mpHand reappears", () => {
+    const fsm = new RescueFSM("SEARCH");
+
+    const res = fsm.update({ t: 200, mpHand: true });
+    expect(res.state).toBe("NORMAL");
+  });
+
+  it("transitions SEARCH -> RESCUE_TRACK when YOLO box >= 0.35 and crop gives 21 points", () => {
+    const fsm = new RescueFSM("SEARCH");
+    const points21 = makeDummyPoints(21);
+
+    const res = fsm.update({
+      t: 200,
+      mpHand: false,
+      yolo: { box: [0.3, 0.3, 0.7, 0.7], score: 0.65 },
+      crop: points21,
+    });
+
+    expect(res.state).toBe("RESCUE_TRACK");
+    expect(res.event).toBe("RESCUE_SUCCESS");
+    expect(res.cropBox).toBeDefined();
+  });
+
+  it("transitions SEARCH -> POSITION_ONLY when box present but no landmarks for >= 500ms", () => {
+    const fsm = new RescueFSM("SEARCH");
+
+    // t=0: YOLO sees box
+    let res = fsm.update({
+      t: 0,
+      mpHand: false,
+      yolo: { box: [0.4, 0.4, 0.6, 0.6], score: 0.5 },
+      crop: null,
+    });
+    expect(res.state).toBe("SEARCH");
+
+    // t=400: still SEARCH
+    res = fsm.update({
+      t: 400,
+      mpHand: false,
+      yolo: { box: [0.4, 0.4, 0.6, 0.6], score: 0.5 },
+      crop: null,
+    });
+    expect(res.state).toBe("SEARCH");
+
+    // t=500: >= 500ms -> POSITION_ONLY
+    res = fsm.update({
+      t: 500,
+      mpHand: false,
+      yolo: { box: [0.4, 0.4, 0.6, 0.6], score: 0.5 },
+      crop: null,
+    });
+    expect(res.state).toBe("POSITION_ONLY");
+    expect(res.event).toBe("POSITION_ONLY_ENTER");
+    expect(res.positionOnly).toEqual({ cx: 0.5, cy: 0.5, score: 0.5 });
+  });
+
+  it("transitions SEARCH -> LOST when neither box nor points for >= 2000ms", () => {
+    const fsm = new RescueFSM("SEARCH");
+
+    // t=0
+    let res = fsm.update({ t: 0, mpHand: false, yolo: null, crop: null });
+    expect(res.state).toBe("SEARCH");
+
+    // t=1900
+    res = fsm.update({ t: 1900, mpHand: false, yolo: null, crop: null });
+    expect(res.state).toBe("SEARCH");
+
+    // t=2000: >= 2000ms -> LOST
+    res = fsm.update({ t: 2000, mpHand: false, yolo: null, crop: null });
+    expect(res.state).toBe("LOST");
+    expect(res.event).toBe("RESCUE_FAIL");
+  });
+
+  it("transitions RESCUE_TRACK -> SEARCH after 3 consecutive crop failures", () => {
+    const fsm = new RescueFSM("RESCUE_TRACK");
+
+    // Fail 1
+    let res = fsm.update({ t: 100, mpHand: false, crop: null });
+    expect(res.state).toBe("RESCUE_TRACK");
+
+    // Fail 2
+    res = fsm.update({ t: 200, mpHand: false, crop: null });
+    expect(res.state).toBe("RESCUE_TRACK");
+
+    // Fail 3 -> transitions back to SEARCH
+    res = fsm.update({ t: 300, mpHand: false, crop: null });
+    expect(res.state).toBe("SEARCH");
+  });
+
+  it("transitions POSITION_ONLY -> RESCUE_TRACK when crop succeeds", () => {
+    const fsm = new RescueFSM("POSITION_ONLY");
+    const points21 = makeDummyPoints(21);
+
+    const res = fsm.update({
+      t: 100,
+      mpHand: false,
+      yolo: { box: [0.4, 0.4, 0.6, 0.6], score: 0.5 },
+      crop: points21,
+    });
+
+    expect(res.state).toBe("RESCUE_TRACK");
+    expect(res.event).toBe("POSITION_ONLY_EXIT");
+  });
+
+  it("transitions LOST -> NORMAL on mpHand or RESCUE_TRACK on box+points", () => {
+    const fsm1 = new RescueFSM("LOST");
+    let res = fsm1.update({ t: 100, mpHand: true });
+    expect(res.state).toBe("NORMAL");
+
+    const fsm2 = new RescueFSM("LOST");
+    const points21 = makeDummyPoints(21);
+    res = fsm2.update({
+      t: 100,
+      mpHand: false,
+      yolo: { box: [0.4, 0.4, 0.6, 0.6], score: 0.5 },
+      crop: points21,
+    });
+    expect(res.state).toBe("RESCUE_TRACK");
+  });
+
+  it("computes square crop with 1.6x scale clamped to [0, 1]", () => {
+    // Centered 0.2 x 0.2 box: cx=0.5, cy=0.5. Side = 0.2 * 1.6 = 0.32
+    const crop = computeCropSquareFromBox([0.4, 0.4, 0.6, 0.6], 1.6);
+    expect(crop[0]).toBeCloseTo(0.5 - 0.16, 4); // 0.34
+    expect(crop[1]).toBeCloseTo(0.5 - 0.16, 4); // 0.34
+    expect(crop[2]).toBeCloseTo(0.5 + 0.16, 4); // 0.66
+    expect(crop[3]).toBeCloseTo(0.5 + 0.16, 4); // 0.66
+
+    // Near border: should clamp to 0 and 1
+    const nearBorder = computeCropSquareFromBox([0.05, 0.05, 0.25, 0.25], 1.6);
+    expect(nearBorder[0]).toBe(0); // clamped at 0
+    expect(nearBorder[1]).toBe(0);
+  });
+
+  it("unmaps landmarks from crop coordinates back to full frame accurately", () => {
+    const crop: [number, number, number, number] = [0.2, 0.3, 0.6, 0.7]; // width 0.4, height 0.4
+    const pts = [{ x: 0.5, y: 0.5, z: 0.1 }]; // center of crop
+
+    const unmapped = unmapLandmarksFromCrop(pts, crop);
+    // frameX = 0.2 + 0.5 * 0.4 = 0.40
+    // frameY = 0.3 + 0.5 * 0.4 = 0.50
+    expect(unmapped[0]!.x).toBeCloseTo(0.40, 4);
+    expect(unmapped[0]!.y).toBeCloseTo(0.50, 4);
+  });
+});
diff --git a/frontend/implementation/tests/nui-lab/monui7-yolo.test.ts b/frontend/implementation/tests/nui-lab/monui7-yolo.test.ts
