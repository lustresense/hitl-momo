  "components": {
    "schemas": {
      "AdminBody": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "maxLength": 200,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 200,
            "minLength": 8,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "name",
          "email",
          "password"
        ],
        "title": "AdminBody"
      },
      "Candidate": {
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Label"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          }
        },
        "type": "object",
        "required": [
          "label",
          "confidence"
        ],
        "title": "Candidate"
      },
      "ClassBody": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "student_count": {
            "type": "integer",
            "maximum": 60.0,
            "minimum": 1.0,
            "title": "Student Count"
          },
          "school_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "School Id"
          }
        },
        "type": "object",
        "required": [
          "name",
          "student_count"
        ],
        "title": "ClassBody"
      },
      "DrawingPayload": {
        "properties": {
          "drawing": {
            "additionalProperties": true,
            "type": "object",
            "title": "Drawing"
          }
        },
        "type": "object",
        "required": [
          "drawing"
        ],
        "title": "DrawingPayload"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JoinBody": {
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Number"
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "number",
          "name"
        ],
        "title": "JoinBody"
      },
      "LoginBody": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginBody"
      },
      "OutcomeBody": {
        "properties": {
          "outcome": {
