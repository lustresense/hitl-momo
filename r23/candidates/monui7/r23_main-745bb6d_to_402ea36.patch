+function makeHandAt(wx: number, wy: number, size = 0.22): WorkerPoint3[] {
+  return Array.from({ length: 21 }, (_, i) => ({
+    x: wx + (i === 0 ? 0 : ((i % 5) / 4) * size),
+    y: wy + (i === 0 ? 0 : (Math.floor(i / 5) / 4) * size),
+    z: 0,
+  }));
+}
