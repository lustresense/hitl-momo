+export function computeCaptureFrameAgeMs(
+  captureTimestampMs: number,
+  nowMs = performance.now(),
+): number {
+  const age = nowMs - captureTimestampMs;
+  return Number.isFinite(age) && age > 0 ? Math.round(age * 100) / 100 : 0;
